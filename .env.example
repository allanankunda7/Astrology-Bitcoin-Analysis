# Server Environment Configuration
PORT=3000
NODE_ENV=production

# Gemini AI API Key (Required for server-side quantitative analysis)
GEMINI_API_KEY=

# Public Application URL
APP_URL=

# Authentication Secret (HMAC-SHA256 signature key for session tokens)
JWT_SECRET=

# Database Storage Path (Optional: defaults to data/trading_database.json)
DATABASE_FILE_PATH=data/trading_database.json

# Market Data API Key (Optional: for premium live data feeds)
MARKET_DATA_API_KEY=
